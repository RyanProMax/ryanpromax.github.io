{
  "name": "ryanzh-private-life",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-23",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "ryanzh.me/api/life/*", "zone_name": "ryanzh.me" },
    { "pattern": "ryanzh.me/_next/static/chunks/app/%5Blocale%5D/life/page-492f02067c8cc73d.js*", "zone_name": "ryanzh.me" },
    { "pattern": "ryanzh.me/_next/static/chunks/app/%255Blocale%255D/life/page-492f02067c8cc73d.js*", "zone_name": "ryanzh.me" },
  ],
  "vars": { "LIFE_HOST": "ryanzh.me" },
  "assets": {
    "directory": "./.assets",
    "binding": "LIFE_ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none",
  },
  "ratelimits": [
    { "name": "LIFE_LOGIN_LIMIT", "namespace_id": "7413", "simple": { "limit": 5, "period": 60 } },
  ],
}
